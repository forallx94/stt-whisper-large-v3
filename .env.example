# docker-compose 의 api 서비스 설정. 이 파일을 .env 로 복사해서 쓴다.
# .env 는 gitignore 대상이다 -- 토큰을 저장소에 올리지 않는다.

# ── 어디까지 열 것인가 ────────────────────────────────────────────────
#
# 127.0.0.1  = 이 서버 자신에서만 접속 가능. 다른 PC 에서 http://<서버IP>:<포트>
#              로 접속하면 연결이 거부된다.
# 0.0.0.0    = 모든 네트워크 인터페이스에서 접속 가능. 사내에서 쓰려면 이 값이다.
#
# 0.0.0.0 으로 열 때는 반드시 STT_API_TOKEN 을 같이 설정한다.
# 지금 구조에는 사용자별 격리가 없어서, 토큰을 가진 사람은 남이 올린 전사본까지
# 전부 목록으로 볼 수 있다. 회의 녹음이 오가는 서비스라 이 점이 중요하다.
STT_BIND=127.0.0.1

# 호스트 쪽 포트. 컨테이너 안은 항상 17860 을 듣고, 이 값이 바깥으로 내보낼 번호다.
# 8000/8080/9000 은 다른 서비스와 자주 겹쳐서 기본값을 17860 으로 잡았다.
# (1024 미만은 권한이 필요하고, 32768~60999 는 리눅스가 발신 포트로 쓰는 구간이라 피한다.)
STT_HOST_PORT=17860

# 설정하면 모든 요청에 Authorization: Bearer <토큰> 이 필요하다. (/healthz 는 예외)
# 비워 두면 접근 가능한 누구나 쓸 수 있다. 생성 예: openssl rand -hex 32
STT_API_TOKEN=

# ── 웹 UI (ui 서비스) ────────────────────────────────────────────────
#
# UI 는 api 를 compose 네트워크 안에서 부르므로, api 를 바깥에 전혀 열지 않고
# (STT_BIND=127.0.0.1 그대로) UI 만 공개하는 구성이 가능하다. 사람은 UI 로,
# 프로그램은 API 로 쓰게 할 거라면 그쪽이 노출 면이 작다.
STT_UI_BIND=127.0.0.1
STT_UI_PORT=17861

# UI 로그인 계정. "user:pass,user2:pass2" 형식.
# 비우면 페이지에 닿는 누구나 쓸 수 있다. UI 는 API 토큰을 대신 들고 있으므로,
# UI 를 열어 두면 토큰을 공개한 것과 같다.
STT_UI_USERS=

# ── 어떤 GPU 를 쓸 것인가 ─────────────────────────────────────────────
#
# 인덱스는 0부터다. RTX 3080 이 7장이면 0~6 이고, "7번째"는 6 이다.
# 단일 GPU 장비(개발 PC 등)에서는 0 으로 두어야 한다.
#
# nvidia-smi 로 번호와 실제 장치를 먼저 확인할 것.
STT_GPU=6

# 컨테이너에 GPU 를 여러 장 넘겼을 때만 필요하다. 한 장만 넘기면 그게 cuda:0 으로
# 보이므로 비워 두면 된다. 예: STT_DEVICE=cuda:2
STT_DEVICE=

# ── 그 밖에 ──────────────────────────────────────────────────────────

# 업로드 원본과 전사 결과를 며칠 뒤 지울지. 0이면 지우지 않는다.
# 남의 회의 녹음이 서버에 무한히 쌓이지 않도록 기본을 짧게 둔다.
STT_RETENTION_DAYS=7

# 업로드 크기 상한(MB). 1시간 40분짜리 m4a 가 대략 50MB 정도다.
STT_MAX_UPLOAD_MB=1024

STT_MODEL=openai/whisper-large-v3
